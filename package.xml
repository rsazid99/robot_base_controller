<?xml version="1.0"?>
<package format="3">
  <name>robot_base_controller</name>
  <version>1.0.0</version>
  <description>
    4WD DDSM115 rover base: motor control over RS485, BNO085 IMU over I2C,
    FlySky i-BUS radio bridge, and an EKF that fuses wheel odometry with the
    IMU to estimate and publish odometry.
  </description>
  <maintainer email="rsazid99@gmail.com">Sazid</maintainer>
  <license>MIT</license>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
